# API Configuration
# Copy file này thành .env và thay đổi các giá trị phù hợp

# API URL - Thay đổi thành địa chỉ IP máy tính khi chạy trên thiết bị thật
# Sử dụng ipconfig (Windows) hoặc ifconfig (Mac/Linux) để lấy IP
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# API Timeout (milliseconds)
EXPO_PUBLIC_API_TIMEOUT=15000
